# ─────────────────────────────────────────────────────────────────────────────
# Funnel ortam değişkenleri. Bu dosyayı `.env.local` olarak kopyalayın.
# Boş bırakılan entegrasyonlar sessizce devre dışı kalır (akış bozulmaz);
# production'da zorunlu olanlar /admin/durum sayfasında kırmızı görünür.
# ─────────────────────────────────────────────────────────────────────────────

# Sitenin kanonik adresi (Calendly webhook adresi ve Meta olay linkleri için)
SITE_URL=http://localhost:3000

# Arama motorları: boş/false iken her sayfa "noindex" ve sitemap kapalı.
# Gerçek içerik girilince true yap ve yeniden deploy et.
ALLOW_INDEXING=

# ── Veritabanı ──────────────────────────────────────────────────────────────
# Production: Vercel Marketplace'ten kurulan Neon (Frankfurt) DATABASE_URL
# (pooled) ve DATABASE_URL_UNPOOLED (migration için) değerlerini kendisi ekler.
# Başka sağlayıcı yalnızca POSTGRES_URL verirse uygulama onu da okur.
# Boşsa yerelde .data/pglite (gömülü Postgres) kullanılır.
DATABASE_URL=

# ── Güvenlik (production'da ZORUNLU, her biri ayrı rastgele değer) ──────────
# Üretmek için: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
LEAD_TOKEN_SECRET=
# Vercel Cron bu değeri Authorization: Bearer başlığıyla gönderir
CRON_SECRET=
# İlk yönetici hesabını /admin/giris ekranından oluşturmak için tek seferlik kod
ADMIN_SETUP_TOKEN=

# ── Meta (Pixel + Conversions API) ──────────────────────────────────────────
NEXT_PUBLIC_META_PIXEL_ID=
# Events Manager → Veri kaynağı → Ayarlar → Conversions API → Erişim belirteci
META_CAPI_ACCESS_TOKEN=
# Yalnızca test sırasında (Events Manager → Test Events). CANLIDA BOŞ BIRAKIN.
META_TEST_EVENT_CODE=
# true: CAPI olayları yalnızca formda pazarlama/ölçüm onayı verenler için gider.
# false: tüm başvurular için gider. Karar müşterinin hukuk danışmanına aittir.
CAPI_REQUIRE_MARKETING_CONSENT=true

# ── Çerez onayı ─────────────────────────────────────────────────────────────
# strict: pixel yalnızca "Kabul et" sonrası yüklenir. notice: hemen yüklenir,
# banner bilgilendirir ve reddetme imkânı verir.
NEXT_PUBLIC_CONSENT_MODE=strict

# ── Calendly (randevular) ───────────────────────────────────────────────────
# Etkinlik linki kodda: config/booking.ts → BOOKING.calendly.url
# Calendly → Integrations → API & Webhooks → Personal access token (ZORUNLU).
# Hesap sahibinin (organizasyon yöneticisi) anahtarı tüm ekibin randevularını okur.
CALENDLY_API_TOKEN=
# Webhook imza anahtarı: kendin üret (yukarıdaki komutla). Webhook Calendly
# Standard ve üstü planda çalışır; /admin/durum → "Webhook'u kur" ile kaydedilir.
# Boşsa değişiklikler yalnızca otomatik eşitlemeyle gelir (vercel.json: Hobby'de
# günde bir 08:00; Vercel Pro'da "0 * * * *" ile saatlik yapılabilir).
CALENDLY_WEBHOOK_SIGNING_KEY=

# ── Airtable (isteğe bağlı): satış ekibinin "Satış Takip" tablosu ─────────────
# airtable.com/create/tokens → scope: data.records:read, data.records:write,
# schema.bases:read; erişim yalnızca bu taban. Tablo ve sütun adları config/airtable.ts'de.
AIRTABLE_TOKEN=
# Tabanın id'si (URL'deki "app…" kısmı)
AIRTABLE_BASE_ID=

# ── E-posta (isteğe bağlı: yalnızca ekibe günlük özet) ──────────────────────
# Başvuranlara e-posta gitmez; onay ve hatırlatmaları Calendly gönderir.
# Kullanılacaksa müşteriye ait Resend hesabı ve kendi alan adı.
RESEND_API_KEY=
# Örn: "Marka Ekip <ekip@mail.markaniz.com>" (domain Resend'de doğrulanmış olmalı)
RESEND_FROM=
# Yanıtların düşeceği gerçek gelen kutusu
RESEND_REPLY_TO=

# ── Opsiyonel ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLARITY_ID=
